# Master thesis style
# Intended use: include figures at \textwidth (or a fraction of it) *without*
# rescaling, so the font sizes below are the sizes printed on the page.
#   \includegraphics[width=\textwidth]{fig.pdf}
# For a figure at 0.49\textwidth, set figsize : 3.1, 2.4 in the script instead.

# ===== FIGURE =====
# Thesis \textwidth = 472.03pt = 6.53 in (report, 12pt, Packages.sty geometry).
# Adjust if \the\textwidth changes (pt / 72.27 = inches). Height ≈ width / golden ratio.
figure.figsize : 6.53, 4.04
figure.dpi : 100                 # screen preview only; keeps plt.show() window sane
figure.constrained_layout.use : True   # handles supxlabel/colorbars/legends cleanly
savefig.dpi : 300                # only matters for rasterised elements
savefig.format : pdf             # vector output for LaTeX
#savefig.bbox : tight
savefig.pad_inches : 0.02
savefig.transparent : False

# ===== FONTS =====
# Matches the thesis body font (Latin Modern Roman via lmodern, documentclass[12pt]).
# Rendered through real LaTeX rather than matplotlib's own font matching: matplotlib
# only knows Latin Modern's family name, not its per-size optical variants, so it was
# picking the 8pt-optical-size glyphs and scaling them up (looked bold/fat at 12-14pt).
text.usetex : False
text.latex.preamble : \usepackage[T1]{fontenc}\usepackage{lmodern}\usepackage{amsmath}\usepackage{siunitx}
font.family : serif
# Figure text slightly smaller than the 12pt body text reads as "figure", not "paragraph"
font.size : 11
axes.labelsize : 11
axes.titlesize : 11              # prefer LaTeX captions over in-figure titles
figure.labelsize : 11
figure.titlesize : 12
legend.fontsize : 10
legend.title_fontsize : 10
xtick.labelsize : 10
ytick.labelsize : 10

# ===== AXES =====
axes.linewidth : 0.8
axes.grid : True
axes.axisbelow : True
axes.labelpad : 4
axes.titlepad : 6
axes.xmargin : 0.02
axes.ymargin : 0.05
axes.formatter.limits : -3, 4    # switch to scientific notation outside 1e-3 .. 1e4
axes.formatter.use_mathtext : True
xaxis.labellocation : right
yaxis.labellocation : top
# Colour-blind safe and distinguishable in greyscale print (Paul Tol "bright")
axes.prop_cycle : cycler('color', ['4477AA', 'EE6677', '228833', 'CCBB44', '66CCEE', 'AA3377', 'BBBBBB'])

# ===== TICKS (MAJOR) =====
# Inward ticks on all four sides: standard look in physics publications
xtick.direction : in
ytick.direction : in
xtick.top : True
ytick.right : True
xtick.major.size : 5
ytick.major.size : 5
xtick.major.width : 0.8
ytick.major.width : 0.8
xtick.major.pad : 4
ytick.major.pad : 4

# ===== TICKS (MINOR) =====
xtick.minor.visible : True
ytick.minor.visible : True
xtick.minor.size : 2.5
ytick.minor.size : 2.5
xtick.minor.width : 0.6
ytick.minor.width : 0.6

# ===== LINES / MARKERS =====
lines.linewidth : 1.2
lines.markersize : 4
lines.markeredgewidth : 0.8
errorbar.capsize : 2
scatter.marker : o
patch.linewidth : 0.8

# ===== LEGEND =====
legend.frameon : True
legend.framealpha : 0.9
legend.edgecolor : 0.8
legend.fancybox : False
legend.borderpad : 0.4
legend.handlelength : 1.8
legend.labelspacing : 0.3

# ===== GRID =====
grid.linestyle : --
grid.linewidth : 0.4
grid.alpha : 0.4
grid.color : 0.6

# ===== IMAGES =====
image.cmap : viridis
